{
  "name": "private-study-tracer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": { "node": "24.22.0", "npm": "11.19.1" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint src scripts tests next.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs oxlint.config.mjs --max-warnings=0 && oxlint --config oxlint.config.mjs --deny-warnings --disable-nested-config src scripts tests next.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs oxlint.config.mjs && node scripts/check-lint-coverage.mjs",
    "lint:coverage": "node scripts/check-lint-coverage.mjs",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "db:start": "tsx scripts/local-db.ts start",
    "db:stop": "tsx scripts/local-db.ts stop",
    "migrate": "tsx scripts/migrate.ts",
    "extractor:build": "tsx scripts/build-extractor.ts",
    "provision": "tsx scripts/provision-synthetic.ts",
    "worker": "tsx src/worker/main.ts",
    "test:restart": "tsx scripts/restart-smoke.ts",
    "boundaries": "node scripts/check-boundaries.mjs",
    "checks": "node scripts/checks.mjs",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "next": "16.4.2",
    "openai": "7.39.0",
    "pg": "8.23.1",
    "pg-boss": "12.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "bun-types": "1.4.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxlint": "1.89.0",
    "typescript-eslint": "8.72.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
