# Copy to .env (git-ignored) and load it in every terminal:  source .env
# Shells do not load .env automatically; scripts/checks.mjs injects these
# values into every child process regardless, so the full gate stays hermetic.

# Ignore any personal ~/.npmrc so installs/audits use only project settings.
export NPM_CONFIG_USERCONFIG=/dev/null

# Disable Next.js telemetry.
export NEXT_TELEMETRY_DISABLED=1

# Optional override — playwright.config.ts already defaults to .local/playwright:
# export PLAYWRIGHT_BROWSERS_PATH="$PWD/.local/playwright"
