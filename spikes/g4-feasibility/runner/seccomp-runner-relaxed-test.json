{
  "comment": "G4 spike TEST-ONLY relaxed profile: identical to seccomp-runner-strict.json but clone/clone3/fork/vfork/wait4/waitid are ALLOWED so the cgroup pids-limit can be demonstrated independently of seccomp (a fork bomb must be able to fork for --pids-limit to be the layer that stops it). Never a production candidate; used only by the res_forkbomb_pids probe and labelled as such in the results.",
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "archMap": [{ "architecture": "SCMP_ARCH_AARCH64", "subArchitectures": [] }],
  "syscalls": [
    {
      "names": [
        "read", "write", "readv", "writev", "close", "close_range", "lseek",
        "pread64", "pwrite64", "fstat", "fstatfs", "statfs", "newfstatat",
        "faccessat", "faccessat2", "statx", "openat", "readlinkat", "getdents64",
        "fcntl", "ioctl", "dup", "dup2", "dup3",
        "mmap", "munmap", "mprotect", "mremap", "madvise", "msync", "brk",
        "futex", "futex_waitv", "rseq", "membarrier", "restart_syscall",
        "set_tid_address", "set_robust_list",
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn", "sigaltstack",
        "getrandom", "getpid", "getppid", "gettid", "getuid", "geteuid",
        "getgid", "getegid", "getgroups", "umask", "getcwd", "chdir", "fchdir",
        "clock_gettime", "clock_getres", "clock_nanosleep", "nanosleep",
        "gettimeofday", "getrusage", "uname", "sysinfo", "sched_getaffinity",
        "sched_yield", "prlimit64", "getrlimit",
        "mkdirat", "unlinkat", "renameat", "renameat2", "fchmod", "fchmodat",
        "clone", "clone3", "fork", "vfork", "wait4", "waitid",
        "kill", "tgkill",
        "execve", "exit", "exit_group"
      ],
      "action": "SCMP_ACT_ALLOW"
    }
  ]
}
